-#ifdef TARGET_PC
+#if defined(TARGET_PC) && !PORT_HOST_BIG_ENDIAN
 			dst[i] = src[sizeof(f32) - 1 - i]; // byte code immediates are big-endian
 #else
 			dst[i] = src[i];
