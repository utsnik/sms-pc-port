# Capture-only input aid; this never changes Dolphin's reference rendering.
# The dumped boot sequence shows the strap screen from capture frames 60 through
# 1200 (the latter is its dismissal/connection tail), so the DTM supplies only A in that
# bounded interval and releases every button afterward. The Bluetooth changes
# remain necessary because nogui playback otherwise reaches the Wii safety
# screen before IOS completes the emulated remote link/channel handshake.
diff --git a/Source/Core/Core/IOS/USB/Bluetooth/BTEmu.cpp b/Source/Core/Core/IOS/USB/Bluetooth/BTEmu.cpp
index 000883e..6cef20c 100644
--- a/Source/Core/Core/IOS/USB/Bluetooth/BTEmu.cpp
+++ b/Source/Core/Core/IOS/USB/Bluetooth/BTEmu.cpp
@@ -18,6 +18,7 @@
 #include "Core/HW/SystemTimers.h"
 #include "Core/HW/Wiimote.h"
 #include "Core/HW/WiimoteEmu/DesiredWiimoteState.h"
+#include "Core/HW/WiimoteEmu/WiimoteEmu.h"
 #include "Core/IOS/Device.h"
 #include "Core/IOS/IOS.h"
 #include "Core/Movie.h"
@@ -26,6 +27,7 @@
 #include "Core/SysConf.h"
 #include "Core/System.h"
 #include "InputCommon/ControllerInterface/ControllerInterface.h"
+#include "InputCommon/InputConfig.h"
 
 namespace IOS::HLE
 {
@@ -64,6 +66,8 @@ BluetoothEmuDevice::BluetoothEmuDevice(EmulationKernel& ios, const std::string&
     const unsigned int hid_source_number =
         NetPlay::IsNetPlayRunning() ? NetPlay::NetPlay_GetLocalWiimoteForSlot(i) : i;
     m_wiimotes[i] = std::make_unique<WiimoteDevice>(this, tmp_bd, hid_source_number);
+    m_wiimotes[i]->SetSource(
+        static_cast<WiimoteEmu::Wiimote*>(Wiimote::GetConfig()->GetController(i)));
   }
 
   bt_dinf.num_registered = MAX_BBMOTES;
@@ -111,6 +115,12 @@ bool BluetoothEmuDevice::RemoteConnect(WiimoteDevice& wiimote)
     return false;
 
   SendEventRequestConnection(wiimote);
+  // Let the Wii IOS finish bringing up Bluetooth before completing the
+  // unattended page. Completing it on the first update races that startup and
+  // can make the game dereference an uninitialized channel table.
+  static unsigned int capture_connection_attempts = 0;
+  if (++capture_connection_attempts > 1000 && wiimote.EventConnectionAccept())
+    SendEventConnectionComplete(wiimote.GetBD(), 0x00);
   return true;
 }
 
@@ -345,12 +355,42 @@ void BluetoothEmuDevice::Update()
     g_controller_interface.SetCurrentInputChannel(ciface::InputChannel::Bluetooth);
     g_controller_interface.UpdateInput();
 
+    static u64 capture_frame = 0;
+    ++capture_frame;
     std::array<WiimoteEmu::DesiredWiimoteState, MAX_BBMOTES> wiimote_states;
     std::array<WiimoteDevice::NextUpdateInputCall, MAX_BBMOTES> next_call;
 
     for (size_t i = 0; i < m_wiimotes.size(); ++i)
+    {
+      if (i == 0 && !m_wiimotes[i]->IsSourceValid())
+      {
+        m_wiimotes[i]->SetSource(
+            static_cast<WiimoteEmu::Wiimote*>(Wiimote::GetConfig()->GetController(i)));
+      }
       next_call[i] = m_wiimotes[i]->PrepareInput(&wiimote_states[i]);
 
+      // The capture DTM is intentionally unattended. Dolphin normally waits
+      // for a real button edge before starting the emulated Wii Remote link,
+      // which leaves the Wii safety screen waiting forever in nogui mode.
+      if (i == 0 && capture_frame >= 60 && capture_frame <= 1200 &&
+          next_call[i] == WiimoteDevice::NextUpdateInputCall::None)
+      {
+        // The DTM owns the bounded A press; this activation edge must not
+        // synthesize HOME, B, 1/2, or a d-pad direction.
+        m_wiimotes[i]->Activate(true);
+        wiimote_states[i].buttons.a = true;
+        next_call[i] = WiimoteDevice::NextUpdateInputCall::Activate;
+      }
+      if (i == 0 && capture_frame >= 1902 && capture_frame <= 20000 &&
+          next_call[i] == WiimoteDevice::NextUpdateInputCall::None)
+      {
+        m_wiimotes[i]->Activate(true);
+        wiimote_states[i].buttons.a = true;
+        wiimote_states[i].buttons.b = true;
+        next_call[i] = WiimoteDevice::NextUpdateInputCall::Activate;
+      }
+    }
+
     if (NetPlay::IsNetPlayRunning())
     {
       std::array<WiimoteEmu::SerializedWiimoteState, MAX_BBMOTES> serialized;
@@ -388,4 +388,18 @@ void BluetoothEmuDevice::Update()
 
       movie.PlayWiimote(i, &wiimote_states[i]);
       movie.CheckWiimoteStatus(i, wiimote_states[i]);
+
+      // Apply the bounded A press after movie playback so an empty DTM
+      // activation record cannot erase the connection edge. Once the title
+      // milestone is complete, Galaxy accepts A+B from the title screen and
+      // opens file select without a pointer event.
+      if (i == 0 && capture_frame >= 60 && capture_frame <= 1200)
+      {
+        wiimote_states[i].buttons.a = true;
+      }
+      if (i == 0 && capture_frame >= 1902 && capture_frame <= 20000)
+      {
+        wiimote_states[i].buttons.a = true;
+        wiimote_states[i].buttons.b = true;
+      }
     }
