                                    WiimoteCommon::HIDWiimote::SensorBarState::Disabled);
     return NextUpdateInputCall::Update;
   }
+  if (IsConnected())
+  {
+    m_hid_source->PrepareInput(wiimote_state, WiimoteCommon::HIDWiimote::SensorBarState::Disabled);
+    return NextUpdateInputCall::Update;
